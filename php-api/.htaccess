# Bloquea acceso HTTP directo a todo lo que no sea un endpoint PHP explícito.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<Files "config.php">
  Require all denied
</Files>

# La carpeta lib/ son clases internas, nunca endpoints — se bloquea entera
# (además cada archivo de lib/ se autoprotege con un guard en PHP).
# scripts/ SÍ queda accesible a propósito: crear-admin.php está pensado para
# visitarse una vez por navegador en hosts sin SSH (ver scripts/crear-admin.php).
# Está protegido por su propio token (ADMIN_BOOTSTRAP_TOKEN) — borralo o renombralo
# después de usarlo.
RewriteEngine On
RewriteRule ^lib/ - [F,L]

# cache/ — caché en disco de las respuestas de Cloudinary (php-api/lib/Cloudinary.php).
# No es sensible (son URLs públicas de Cloudinary) pero tampoco tiene que
# responder por HTTP directo.
RewriteRule ^cache/ - [F,L]

# CORS / headers comunes los pone cada script vía config.php — no se setean acá
# para no pisar las respuestas de error con código de estado distinto de 200.
